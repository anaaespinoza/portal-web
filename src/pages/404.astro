---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Página no encontrada | Tecnológico Superior de Jalisco"
  description="La página que buscas no existe o fue movida en el sitio del Tecnológico Superior de Jalisco."
  noindex
>
  <section style="padding:4rem 2rem;text-align:center;font-family:'madaniArabicLight',sans-serif;color:var(--textdark)">
    <h1 style="font-family:'madaniArabicMedium',sans-serif;color:var(--navy-blue-dark);font-size:2rem;margin:0 0 1rem">
      404 — Página no encontrada
    </h1>
    <p style="margin:0 0 1.5rem">La página que buscas no existe o fue movida.</p>
    <a href="/" style="color:var(--navy-blue-dark);text-decoration:underline">Volver al inicio</a>
  </section>
</BaseLayout>