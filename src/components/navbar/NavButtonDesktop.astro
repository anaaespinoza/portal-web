---
// Botón/item del navbar de escritorio (port de navbuttondesktop.tsx del SPA)
import type { NavItem } from "./navitems";

interface Props {
  item: NavItem;
}

const { item } = Astro.props;
const pathname = Astro.url.pathname;
const isExternal = (href: string) => href.startsWith("http");
---

<div class="tl-navbtn">
  {item.options.length > 0 ? (
    <>
      <button class="tl-navbtn" aria-haspopup="true">
        {item.title}
        <span class="tl-caret"></span>
      </button>
      <div class="tl-dropdown">
        {item.options.map((option) => (
          <a
            href={option.path}
            {isExternal(option.path) && "target=_blank"}
            {isExternal(option.path) && "rel=noopener noreferrer"}
          >
            {option.label}
          </a>
        ))}
      </div>
    </>
  ) : item.isExternal ? (
    <a class="tl-a" href={item.path} target="_blank" rel="noopener noreferrer">
      {item.title}
    </a>
  ) : (
    <a class="tl-a" href={item.path || ("/" + pathname + "#" + item.anchor)}>
      {item.title}
    </a>
  )}
</div>

<style is:global>
  .tl-navbtn {
    position: relative;
    display: flex;
    align-items: center;
    color: #fff;
    background: none;
    border: 0;
    font-family: "madaniArabicLight", sans-serif;
    font-size: 0.8rem;
    margin: 0 px;
    padding: 6px 4px;
    border-radius: 4px;
    cursor: pointer;
  }
  .tl-navbtn:hover {
    background-color: var(--greydark);
  }
  .tl-caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #fff;
    margin-left: 6px;
    transition: transform 0.15s ease;
  }
  .tl-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    background-color: var(--greydark);
    color: #fff;
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    padding: 4px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .tl-navbtn:hover .tl-dropdown,
  .tl-dropdown:hover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .tl-dropdown a {
    display: block;
    color: #fff;
    text-decoration: none;
    font-family: "madaniArabicLight", sans-serif;
    font-size: 0.8rem;
    padding: 8px 12px;
  }
  .tl-dropdown a:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }
  .tl-a {
    color: #fff;
    text-decoration: none;
    font-family: "madaniArabicLight", sans-serif;
    font-size: 0.8rem;
    margin: 0 10px;
    padding: 8px 10px;
    display: inline-block;
  }
</style>