---
// Redirect — página de redirección estática (meta refresh + canonical)
interface Props {
  to: string;
}

const { to } = Astro.props;
const siteUrl = "https://www.tecmm.edu.mx";
const canonical = to.startsWith("http") ? to : siteUrl + to;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex,nofollow" />
    <title>Redirigiendo…</title>
  </head>
  <body>
    <p style="font-family: system-ui, sans-serif; padding: 2rem;">
      Redirigiendo a <a href={to}>{to}</a>…
    </p>
  </body>
</html>