---
// SectionContainer.astro — Container común del landing
// Origen: <Container maxWidth="xl" sx={{ px: { xs: 2, sm: 3, md: 6 }, maxWidth: { md: "1100px", lg: "1400px", xl: "1436px" } }} />
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`section-container${className ? ` ${className}` : ""}`}>
  <slot />
</div>

<style>
  .section-container {
    width: 100%;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 600px) {
    .section-container {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .section-container {
      max-width: 1100px;
      padding-inline: 3rem;
    }
  }

  @media (min-width: 1200px) {
    .section-container {
      max-width: 1400px;
    }
  }

  @media (min-width: 1536px) {
    .section-container {
      max-width: 1436px;
    }
  }
</style>