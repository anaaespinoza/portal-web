---
// Hero del Landing — video de fondo CDN con controles play/mute
// Origen: <Landing /> (src/screens/landing) — video section + divLottie
const VIDEO_SRC =
  "https://tecmm.mx/cdn/public/WEB-TSJ/IMAGES/GENERAL/2038efbf8e4b45cf9844e347d69cd15d.mp4";
---

<section class="hero-video" id="inicio" aria-label="Video institucional">
  <video
    id="hero-video"
    src={VIDEO_SRC}
    autoplay
    loop
    muted
    playsinline
  ></video>

  <div class="hero-controls" role="group" aria-label="Controles del video">
    <button id="btn-mute" class="hero-ctrl" type="button" aria-label="Silenciar o activar sonido">
      <svg id="icon-volume" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9v6h4l5 5V4l-5 5H7z"/></svg>
    </button>

    <button id="btn-play" class="hero-ctrl" type="button" aria-label="Pausar o reproducir">
      <svg id="icon-play-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>
  </div>
</section>

<style>
  .hero-video {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    margin-top: -10px;
  }

  .hero-video video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .hero-controls {
    position: absolute;
    bottom: 3%;
    left: 92%;
    height: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    z-index: 10;
  }

  .hero-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .hero-ctrl svg {
    width: 36px;
    height: 36px;
    fill: #fff;
  }

  @media (min-width: 350px) and (max-width: 1024px) {
    .hero-controls {
      bottom: 10%;
      width: 2rem;
      height: 10rem;
      left: 2dvw;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const VIDEO_PLAY =
    "M8 5v14l11-7z";
  const VIDEO_PAUSE =
    "M6 19h4V5H6v14zm8-14v14h4V5h-4z";
  const VOLUME_UP =
    "M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z";
  const VOLUME_MUTE =
    "M7 9v6h4l5 5V4l-5 5H7z";

  const video = document.querySelector<HTMLVideoElement>("#hero-video");
  const btnPlay = document.querySelector<HTMLButtonElement>("#btn-play");
  const btnMute = document.querySelector<HTMLButtonElement>("#btn-mute");
  const playPath = document.querySelector<SVGPathElement>("#icon-play-pause path");
  const volumePath = document.querySelector<SVGPathElement>("#icon-volume path");

  function syncPlayIcon() {
    if (!playPath || !video) return;
    playPath.setAttribute("d", video.paused ? VIDEO_PLAY : VIDEO_PAUSE);
  }

  function syncVolumeIcon() {
    if (!volumePath || !video) return;
    volumePath.setAttribute("d", video.muted ? VOLUME_MUTE : VOLUME_UP);
  }

  if (video) {
    btnPlay?.addEventListener("click", () => {
      if (video.paused) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    });

    btnMute?.addEventListener("click", () => {
      video.muted = !video.muted;
    });

    video.addEventListener("play", syncPlayIcon);
    video.addEventListener("pause", syncPlayIcon);
    video.addEventListener("volumechange", syncVolumeIcon);

    syncPlayIcon();
    syncVolumeIcon();
  }
</script>