---

<div class="stats">
  <ul class="stats-grid">
    {items.map((item, index) => (
      <li class="stats-item" data-last={index === items.length - 1 ? "true" : "false"}>
        <a href={item.to} style={`--accent: ${item.color}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.d} /></svg>
          <span class="stats-cifra">{item.cifra}</span>
          <span class="stats-texto">{item.texto}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .stats {
    width: 100%;
    max-width: 1320px;
    margin: 4rem auto 4rem;
    padding-inline: 1rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
    background-color: #fff;
    border-radius: 24px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    align-items: center;
    row-gap: 2.5rem;
    padding-block: 1rem 2.5rem;
  }

  .stats-item {
    display: flex;
    justify-content: center;
    padding: 0.5rem 1rem;
  }

  .stats-item a {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease-in-out, opacity 0.2s ease-in-out;
  }

  .stats-item a:hover {
    transform: translateY(-3px);
    opacity: 0.85;
  }

  .stats-item svg {
    width: 2.8rem;
    height: 2.8rem;
    flex-shrink: 0;
    fill: var(--accent);
  }

  .stats-cifra {
    display: block;
    font-family: "madaniArabicBold", sans-serif;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--accent);
  }

  .stats-texto {
    display: block;
    font-family: "Madani Regular", sans-serif;
    font-size: 0.85rem;
    color: var(--text);
    white-space: nowrap;
  }

  @media (min-width: 600px) {
    .stats {
      margin-top: 2.5rem;
      padding-inline: 1.5rem;
    }
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 3rem;
      padding: 1.5rem 2rem;
    }
    .stats-item {
      justify-content: flex-start;
    }
  }

  @media (min-width: 900px) {
    .stats {
      margin-top: 2rem;
      padding-inline: 3rem;
    }
    .stats-grid {
      grid-template-columns: repeat(5, 1fr);
      row-gap: 0;
      padding: 1rem 0.5rem;
    }
    .stats-item {
      justify-content: center;
    }
    .stats-item[data-last="false"] {
      border-right: 1px solid rgba(0, 0, 0, 0.1);
    }
  }
</style>