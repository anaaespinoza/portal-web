---
// InfoBlock.astro — Bloque split imagen + texto reutilizable
// Origen: <InfoBlock /> (src/components/infoblock/infoblock.tsx)
// Usado por: Inscripciones, TSJ en Línea, Investigación, Servicios a la Red.
import type { InfoDescriptionPart } from "../../lib/infoData";

interface Props {
  titulo: string;
  descripcion: InfoDescriptionPart[];
  imagen: string;
  alt?: string;
  reverse?: boolean;
  link?: string;
}

const { titulo, descripcion, imagen, alt, reverse = false, link } = Astro.props;
const imageAlt = alt ?? titulo;
const dataReverse = reverse ? "true" : "false";
---

<div class="infoblock" data-reverse={dataReverse}>
  <div class="infoblock-media">
    {link ? (
      <a href={link}>
        <img src={imagen} alt={imageAlt} loading="lazy" />
      </a>
    ) : (
      <img src={imagen} alt={imageAlt} loading="lazy" />
    )}
  </div>

  <div class="infoblock-copy">
    <h2 class="infoblock-titulo">{titulo}</h2>
    <p class="infoblock-descripcion">
      {
        descripcion.map((part) =>
          part.link ? <a href={part.link}>{part.text}</a> : part.text,
        )
      }
    </p>
  </div>
</div>

<style>
  .infoblock {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px; /* gap: 4 */
    align-items: flex-start;
    margin-bottom: 64px; /* mb: 8 */
  }

  .infoblock-media {
    order: 1;
  }

  .infoblock-copy {
    order: 2;
  }

  .infoblock-media a {
    display: block;
    text-decoration: none;
  }

  .infoblock-media img {
    width: 100%;
    border-radius: 16px;
    object-fit: cover;
    display: block;
  }

  .infoblock-media a img {
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .infoblock-media a:hover img {
    transform: scale(1.02);
  }

  .infoblock-titulo {
    font-family: "madaniArabicSemiBold", sans-serif;
    text-align: left;
    font-size: 2rem;
    font-weight: 500;
    margin: 0 0 24px 0; /* mb: 3 */
  }

  .infoblock-descripcion {
    color: var(--text);
    font-size: 1.5rem;
    text-align: left;
    line-height: 1.6;
    font-weight: 300;
    margin: 0;
  }

  .infoblock-descripcion a {
    color: inherit;
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s ease-in-out;
  }

  .infoblock-descripcion a:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .infoblock {
      grid-template-columns: 1fr 1fr;
    }

    .infoblock[data-reverse="true"] .infoblock-media {
      order: 2;
    }

    .infoblock[data-reverse="true"] .infoblock-copy {
      order: 1;
    }
  }
</style>